# env.example — template for dev.env / prod.env (both gitignored).
# Copy per box: dev compose reads dev.env, prod compose reads prod.env.
# Compose parse-time values (version pins, CFD_PRIVATE_KEY_PATH, dev build
# args) live in .env instead. [PER-ENV] marks values that differ by env.

# [PER-ENV] development | production
ENVIRONMENT=development

# [PER-ENV] Frontend URL, used by api-auth for magic-link emails.
# dev: http://localhost   prod: https://tabletop-tavern.uk (must be https)
NEXT_PUBLIC_API_URL=http://localhost

# ── MONGO ────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=<mongo-root-user>
MONGO_INITDB_ROOT_PASSWORD=<mongo-root-password>
MONGO_INITDB_DATABASE=rollplay

# ── POSTGRESQL ───────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=rollplay
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
APP_DB_USER=rollplay_app
APP_DB_PASSWORD=<app-db-password>

# ── LOGGING ──────────────────────────────────────────────────────────
LOGGING_LOG_LEVEL=INFO
logging_email_from=""
logging_email_to=""
logging_email_subject=test

# ── EMAIL (magic link auth — Mailtrap Sending API, no SMTP) ──────────
MAIL_TRAP_API_TOKEN=<mailtrap-sending-api-token>
FROM_EMAIL=<from-address>

# ── REDIS (short code storage) ───────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── SENTRY (env tag derives from ENVIRONMENT) ────────────────────────
SENTRY_ORG=rollplay
SENTRY_PROJECT_NEXTJS=rollplay-app
SENTRY_DSN_API_SITE=<dsn>
SENTRY_PROJECT_API_SITE=rollplay-api-site
SENTRY_DSN_API_GAME=<dsn>
SENTRY_PROJECT_API_GAME=rollplay-api-game
SENTRY_DSN_API_AUTH=<dsn>
SENTRY_PROJECT_API_AUTH=rollplay-api-auth
NEXT_PUBLIC_SENTRY_DSN=<dsn>
SENTRY_PROJECT=rollplay-app

# ── JWT AUTHENTICATION (shared secret across api services) ───────────
JWT_SECRET_KEY=<jwt-secret>
JWT_ALGORITHM=HS256
# Token lifetimes (optional - api-auth defaults to 15 minutes / 7 days).
# The refresh token is re-issued on every refresh, so the refresh window
# restarts on use and an active user is never logged out.
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AWS / CDN — strict 1:1 CFD:bucket per environment ────────────────
# [PER-ENV] dev: d3prsa4h53bww8.cloudfront.net  prod: d3mtesl8j8vsqt.cloudfront.net
AWS_CFD_S3_URL=<cloudfront-domain>
# signing-key path (CFD_PRIVATE_KEY_PATH) comes from compose/.env
CFD_KEY_PAIR_ID=<key-pair-id>
# [PER-ENV] dev: table-top-tavern-assets-dev  prod: table-top-tavern-assets
S3_BUCKET_NAME=<bucket-name>
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
# Presigned URL expiry in seconds (86400 = 24h)
PRESIGNED_URL_EXPIRY=86400

# ── LIVEKIT / STREAM ─────────────────────────────────────────────────
LIVEKIT_URL=<wss-url>
LIVEKIT_API_KEY=<key>
LIVEKIT_API_SECRET=<secret>
NEXT_PUBLIC_LIVEKIT_URL=<wss-url>
STREAM_PASS=<password>

# ── SPOTIFY ──────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=<client-id>
SPOTIFY_CLIENT_SECRET=<client-secret>
SPOTIFY_APP_NAME=rollplay
# [PER-ENV] Must EXACTLY match a Redirect URI in the Spotify dashboard.
# dev: http://127.0.0.1:80/api/spotify/callback (loopback is the only http allowed)
# prod: https://tabletop-tavern.uk/api/spotify/callback
SPOTIFY_REDIRECT_URI=<redirect-uri>
